---
// The signature moment: a hand-drawn underline that draws itself once on load.
// Static (fully drawn) when prefers-reduced-motion is set.
---

<svg
  class="pen-stroke"
  viewBox="0 0 300 12"
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <path d="M2 8 C 50 3, 95 10, 150 6 S 250 9, 298 4"></path>
</svg>

<style>
  .pen-stroke {
    display: block;
    width: min(100%, 22ch);
    height: 0.65rem;
    margin-top: 0.35rem;
    overflow: visible;
  }

  path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3.5;
    stroke-linecap: round;
    stroke-dasharray: 310;
    stroke-dashoffset: 310;
    animation: draw 0.6s ease-out 0.15s forwards;
  }

  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    path {
      stroke-dashoffset: 0;
      animation: none;
    }
  }
</style>
