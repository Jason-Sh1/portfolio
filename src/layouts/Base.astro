---
import '../styles/global.css';
import { profile, revision } from '../data/profile';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  /** Part number shown in the header band, e.g. "IP-1" on a project sheet. */
  part?: string;
}

const { title, description = profile.description, part = profile.part } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Set theme before first paint to avoid a flash of the wrong theme.
      const saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') {
        document.documentElement.dataset.theme = saved;
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="band">
      <div class="sheet band-row">
        <a class="band-id" href="/" aria-label={`${profile.name}, home`}>
          <span class="band-part">{part}</span>
          <span class="band-name">{profile.name}</span>
        </a>
        <nav aria-label="Site" class="band-nav">
          <a href="/#work">Work</a>
          <a href="/#experience">Experience</a>
          <a href="/#contact">Contact</a>
          <span class="band-rev" aria-label={`Revised ${revision}`}>Rev. {revision}</span>
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main id="main" class="sheet">
      <slot />
    </main>

    <footer class="sheet foot" id="contact">
      <h2 class="sec">Contact</h2>
      <div class="foot-grid">
        <p class="foot-lede">
          The fastest way to reach me is email.
        </p>
        <a class="foot-mail" href={`mailto:${profile.email}`}>{profile.email}</a>
        <ul class="foot-links">
          {
            profile.links
              .filter((l) => !l.href.startsWith('mailto:'))
              .map((link) => (
                <li>
                  <a href={link.href} rel="me">
                    {link.label}
                  </a>
                </li>
              ))
          }
        </ul>
      </div>
      <div class="foot-strip">
        <span>{profile.name} · {profile.part} · Rev. {revision}</span>
        <span>
          Set in Archivo · Built with Astro ·{' '}
          <a href="https://github.com/Jason-Sh1/portfolio">Source</a>
        </span>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--signal);
    color: var(--signal-ink);
    padding: 0.5rem 1rem;
    z-index: 10;
  }

  .skip-link:focus {
    left: 0.5rem;
    top: 0.5rem;
  }

  .band {
    border-bottom: 3px solid var(--rule);
  }

  .band-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
    padding-block: 0.85rem;
  }

  .band-id {
    display: inline-flex;
    align-items: stretch;
    text-decoration: none;
    color: var(--ink);
    font-size: 0.95rem;
    line-height: 1;
  }

  .band-part {
    background: var(--signal);
    color: var(--signal-ink);
    font-stretch: 125%;
    font-weight: 800;
    padding: 0.45rem 0.6rem 0.4rem;
    letter-spacing: 0.02em;
  }

  .band-name {
    border: 1px solid var(--rule);
    border-left: 0;
    padding: 0.4rem 0.7rem 0.35rem;
    font-weight: 650;
    font-stretch: 90%;
  }

  .band-id:hover .band-name {
    background: var(--ink);
    color: var(--paper);
  }

  .band-nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    font-size: 0.85rem;
    font-stretch: 85%;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .band-nav a {
    text-decoration: none;
  }

  .band-nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .band-rev {
    color: var(--ink-3);
    font-weight: 500;
    padding-left: 1.4rem;
    border-left: 1px solid var(--hair);
  }

  main {
    padding-bottom: 4rem;
  }

  .foot {
    padding-bottom: 2rem;
  }

  .foot-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem 2rem;
    align-items: end;
    padding-block: 0.5rem 2.5rem;
  }

  .foot-lede {
    grid-column: 1 / -1;
    color: var(--ink-2);
    margin: 0;
  }

  .foot-mail {
    font-size: clamp(1.5rem, 4.2vw, 3rem);
    font-stretch: 115%;
    font-weight: 750;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
    text-decoration-color: var(--ink);
    overflow-wrap: anywhere;
  }

  .foot-links {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    font-weight: 600;
  }

  .foot-strip {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    border-top: 1px solid var(--rule);
    padding-top: 0.6rem;
    font-size: 0.8rem;
    color: var(--ink-3);
  }

  @media (max-width: 760px) {
    .band-rev {
      display: none;
    }

    .band-nav {
      gap: 1rem;
    }

    .foot-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
