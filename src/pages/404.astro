---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Jason Shi" description="This page doesn't exist.">
  <section class="notfound">
    <p class="mono code">404</p>
    <h1>Not in the notebook.</h1>
    <p>This page doesn't exist — the link may be old or mistyped.</p>
    <p class="mono"><a href="/">← Back to the front page</a></p>
  </section>
</Base>

<style>
  .notfound {
    padding-block: calc(var(--cell) * 3);
  }

  .code {
    color: var(--rule);
    font-size: 0.9rem;
    letter-spacing: 0.14em;
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    margin-bottom: 0.75rem;
  }
</style>
