---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, date, summary, tags, github, demo } = project.data;
const { Content } = await render(project);

const logDate = date.toISOString().slice(0, 7);
---

<Base title={`${title} — Jason Shi`} description={summary}>
  <article>
    <header class="project-header">
      <p class="mono breadcrumb">
        <a href="/#work">← Selected work</a>
      </p>
      <p class="mono date">
        <time datetime={date.toISOString().slice(0, 10)}>{logDate}</time>
      </p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <p class="mono meta">
        {tags.map((tag) => <span class="tag">{tag}</span>)}
      </p>
      <p class="mono links">
        {github && <a href={github}>GitHub ↗</a>}
        {demo && <a href={demo}>Live ↗</a>}
      </p>
      <hr class="margin-rule" />
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

<style>
  .project-header {
    padding-block: var(--cell) 0;
  }

  .breadcrumb {
    font-size: 0.85rem;
    margin-bottom: calc(var(--cell) * 1.5);
  }

  .breadcrumb a {
    color: var(--graphite);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .date {
    font-size: 0.85rem;
    color: var(--graphite);
    margin-bottom: 0.5rem;
  }

  h1 {
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    margin-bottom: 0.75rem;
  }

  .summary {
    font-size: 1.15rem;
    color: var(--graphite);
    max-width: 56ch;
  }

  .meta {
    font-size: 0.78rem;
    color: var(--graphite);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    margin-bottom: 0.75rem;
  }

  .tag::before {
    content: '·';
    margin-right: 0.9rem;
  }

  .tag:first-child::before {
    content: none;
    margin: 0;
  }

  .links {
    display: flex;
    gap: 1.25rem;
    font-size: 0.9rem;
    margin-bottom: var(--cell);
  }

  .prose {
    padding-block: var(--cell);
    max-width: 62ch;
  }

  .prose :global(h2) {
    font-size: 1.4rem;
    margin-block: calc(var(--cell) * 1.25) 0.5rem;
  }

  .prose :global(ul) {
    padding-left: 1.25rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }
</style>
